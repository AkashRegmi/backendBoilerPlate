doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= subject
    style.
      /* Reset and Base Styles */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { margin: 0; padding: 0; font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif; background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 100%); }
      table { border-collapse: collapse; width: 100%; }
      img { max-width: 100%; height: auto; display: block; border: 0; }
      a { text-decoration: none; transition: all 0.3s ease; }

      /* Pink Color Palette */
      :root {
        --pink-primary: #ec4899;
        --pink-secondary: #f472b6;
        --pink-light: #fce7f3;
        --pink-dark: #db2777;
        --pink-gradient: linear-gradient(to right, #ec4899, #f472b6);
      }

      /* Container */
      .container { width: 600px; max-width: 100%; margin: 0 auto; }

      /* Header - Pink theme */
      .header { background: linear-gradient(to right, #ec4899, #f472b6); padding: 15px 20px 20px 20px; text-align: center; border-radius: 12px 12px 0 0; }

      /* Main Card - Reduced padding */
      .card { background: #ffffff; border-radius: 0 0 12px 12px; padding: 30px 25px; box-shadow: 0 10px 30px rgba(236, 72, 153, 0.1); }

      /* Typography with tighter spacing */
      h1 { color: #1f2937; font-size: 26px; font-weight: 700; margin-bottom: 12px; line-height: 1.3; text-align: center; }
      h2 { color: #1f2937; font-size: 20px; font-weight: 600; margin-bottom: 15px; text-align: center; }
      h3 { color: #ec4899; font-size: 17px; font-weight: 600; margin-bottom: 12px; text-align: center; }
      p { color: #4b5563; font-size: 15px; line-height: 1.5; margin-bottom: 15px; text-align: center; }
      .highlight { background-color: #fdf2f8; border-left: 4px solid #ec4899; padding: 12px 15px; margin: 18px 0; border-radius: 0 8px 8px 0; text-align: center; }

      /* Buttons - Pink theme */
      .btn-primary { background: linear-gradient(to right, #ec4899, #f472b6); color: #fff; padding: 12px 28px; text-decoration: none; border-radius: 8px; display: inline-block; font-weight: 600; font-size: 15px; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.3); margin: 0 auto; }
      .btn-primary:hover { background: linear-gradient(to right, #db2777, #ec4899); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(236, 72, 153, 0.4); }
      .btn-secondary { background: #fdf2f8; color: #9d174d; padding: 10px 20px; text-decoration: none; border-radius: 8px; display: inline-block; font-weight: 600; font-size: 14px; border: 1px solid #fbcfe8; margin: 0 auto; }
      .btn-secondary:hover { background: #fce7f3; }

      /* OTP Specific Styles */
      .otp-container { margin: 20px 0; text-align: center; }
      .otp-code { display: inline-block; background: #fdf2f8; padding: 15px 25px; font-size: 28px; font-weight: 700; letter-spacing: 8px; color: #9d174d; border-radius: 8px; border: 2px dashed #f9a8d4; margin: 10px 0; font-family: 'Courier New', monospace; }
      .otp-warning { font-size: 13px; color: #dc2626; margin-top: 10px; }

      /* Footer - More compact */
      .footer { padding: 20px 15px; text-align: center; color: #9ca3af; font-size: 13px; background: #fdf2f8; border-radius: 0 0 12px 12px; }
      .footer-links a { color: #9d174d; margin: 0 8px; text-decoration: none; font-size: 13px; }
      .footer-links a:hover { color: #be185d; }
      .social-icons { margin: 15px 0; text-align: center; }
      .social-icons a { display: inline-block; margin: 0 6px; }
      .social-icons img { width: 20px; height: 20px; opacity: 0.7; filter: hue-rotate(300deg); }
      .social-icons img:hover { opacity: 1; }

      /* Divider - Thinner with pink tint */
      .divider { height: 1px; background: linear-gradient(to right, transparent, #fbcfe8, transparent); margin: 20px 0; }

      /* Feature boxes - More compact */
      .feature-box { background: #fdf2f8; border-radius: 8px; padding: 15px; margin-bottom: 15px; text-align: center; border: 1px solid #fbcfe8; }
      .feature-icon { font-size: 20px; margin-bottom: 8px; color: #ec4899; }

      /* Content sections - Tighter spacing */
      .content-section { margin-bottom: 20px; }

      /* Centered content containers */
      .centered-content { text-align: center; }
      .centered-table { margin-left: auto; margin-right: auto; }

      /* Pink accent elements */
      .pink-accent { color: #ec4899; }
      .pink-bg { background-color: #fdf2f8; }

      /* Mobile Responsive */
      @media only screen and (max-width: 620px) {
        .container { width: 100% !important; padding: 8px !important; }
        .card { padding: 20px 15px !important; }
        .header { padding: 12px 15px 15px 15px !important; }
        h1 { font-size: 22px !important; margin-bottom: 10px !important; }
        h2 { font-size: 18px !important; margin-bottom: 12px !important; }
        h3 { font-size: 16px !important; margin-bottom: 10px !important; }
        p { font-size: 14px !important; margin-bottom: 12px !important; }
        .btn-primary, .btn-secondary { padding: 10px 20px !important; font-size: 14px !important; }
        .footer { padding: 15px 10px !important; }
        .feature-box { padding: 12px !important; margin-bottom: 12px !important; }
        .highlight { padding: 10px 12px !important; margin: 15px 0 !important; }
        .otp-code { font-size: 24px !important; padding: 12px 20px !important; letter-spacing: 6px !important; }
      }

      @media only screen and (max-width: 480px) {
        h1 { font-size: 20px !important; }
        h2 { font-size: 17px !important; }
        .card { padding: 18px 12px !important; }
        .otp-code { font-size: 22px !important; padding: 10px 15px !important; letter-spacing: 4px !important; }
      }

  body
    table(width="100%" cellpadding="0" cellspacing="0")
      tr
        td(align="center" style="padding: 30px 10px;")
          table(class="container" width="600" cellpadding="0" cellspacing="0")
            // Header with pink theme
            tr
              td(class="header")
                a(href="https://yourshop.com" style="display: inline-block; margin-bottom: 10px;")
                  img(src="https://cdn.pixabay.com/photo/2017/03/16/21/18/logo-2150297_1280.png" alt="ShopStyle Logo" width="70" style="margin: 0 auto; filter: brightness(0) invert(1);")
                h2(style="color: white; font-size: 18px; margin-bottom: 4px;") Your Pink Boutique
                p(style="color: rgba(255,255,255,0.9); font-size: 13px; margin: 0;") Discover beautiful products

            // Main Card Content
            tr
              td
                table(width="100%" cellpadding="0" cellspacing="0" class="card")
                  // Main title with proper top spacing
                  tr
                    td(style="padding-top: 0; padding-bottom: 15px;")
                      h1 #{subject}

                  // Divider
                  tr
                    td
                      .divider

                  // Dynamic content block
                  tr
                    td(class="centered-content" style="padding-top: 10px;")
                      block content

                  // Call to action section
                  tr
                    td(style="padding-top: 20px;")
                      .divider
                      h3(style="margin-bottom: 12px;") Need Help?
                      p(style="font-size: 14px; margin-bottom: 18px;") Our team is here for you 24/7.
                      table(class="centered-table" cellpadding="0" cellspacing="0")
                        tr
                          td
                            a(href="https://yourshop.com/contact" class="btn-secondary") Contact Support

            // Footer with pink background
            tr
              td(class="footer")
                // Social icons
                .social-icons
                  a(href="https://facebook.com/yourshop")
                    img(src="https://cdn-icons-png.flaticon.com/512/124/124010.png" alt="Facebook")
                  a(href="https://instagram.com/yourshop")
                    img(src="https://cdn-icons-png.flaticon.com/512/174/174855.png" alt="Instagram")
                  a(href="https://twitter.com/yourshop")
                    img(src="https://cdn-icons-png.flaticon.com/512/124/124021.png" alt="Twitter")
                  a(href="https://pinterest.com/yourshop")
                    img(src="https://cdn-icons-png.flaticon.com/512/124/124039.png" alt="Pinterest")

                // Footer links
                .footer-links(style="margin: 15px 0;")
                  a(href="https://yourshop.com/about") About Us
                  a(href="https://yourshop.com/contact") Contact
                  a(href="https://yourshop.com/blog") Blog
                  a(href="https://yourshop.com/faq") FAQ

                // Copyright
                p(style="margin-bottom: 8px; font-size: 12px; color: #9d174d;") © #{new Date().getFullYear()} Pink Boutique. All rights reserved.
                p(style="font-size: 12px; margin-bottom: 4px; color: #9d174d;") 1234 Fashion Street, Suite 567

                // Legal links
                .footer-links(style="margin-top: 15px;")
                  a(href="https://yourshop.com/privacy") Privacy Policy
                  a(href="https://yourshop.com/terms") Terms of Service
                  a(href="https://yourshop.com/unsubscribe" style="color: #ec4899; font-weight: 600;") Unsubscribe
